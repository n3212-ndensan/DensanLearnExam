@page "/"
@rendermode InteractiveServer
@inject IStateBox<List<Employee>> sessionState
@inject NavigationManager NavManager

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<p>Welcome to your new app.</p>

<div>
    <button class="btn btn-primary" @onclick="NavigateToEmployeeAddPageAsync">社員追加</button>
</div>

<div>
    <RadzenDataGrid TItem="Employee" Data="list" LoadData="LoadEmployeeListAsync">
        <Columns>
            <RadzenDataGridColumn Title="氏名">
                <Template>
                    @context.Name
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="入社日">
                <Template>
                    @context.JoiningDate.ToString("yyyy-MM-dd")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="雇用形態">
                <Template>
                    @GetEmploymentTypeName(context.EmploymentType)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="備考">
                <Template>
                    @context.Biko.Split("\n")[0]
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
